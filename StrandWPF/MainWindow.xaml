<Window x:Class="StrandWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StrandWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900
        ">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2"/>
        </Grid.ColumnDefinitions>
        <Label Content="Név" HorizontalAlignment="Left" Margin="23,29,0,0" VerticalAlignment="Top" Width="123"/>
        <Label Content="Cím" HorizontalAlignment="Left" Margin="23,95,0,0" VerticalAlignment="Top" Width="123"/>
        <Label Content="Ár" HorizontalAlignment="Left" Margin="23,173,0,0" VerticalAlignment="Top" Width="123"/>
        <Label Content="Vizhofok" HorizontalAlignment="Left" Margin="23,217,0,0" VerticalAlignment="Top" Width="123"/>
        <TextBox x:Name="nev" HorizontalAlignment="Left" Margin="23,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="cim" HorizontalAlignment="Left" Margin="26,124,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="ar" HorizontalAlignment="Left" Margin="26,199,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="vizhofok" HorizontalAlignment="Left" Margin="26,243,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Content="mentés" HorizontalAlignment="Center" Margin="0,339,0,0" VerticalAlignment="Top" Width="429" Click="Button_Click"/>
        <ProgressBar x:Name="progressbar" Minimum="0" Maximum="100" HorizontalAlignment="Left" Height="30" Margin="10,304,0,0" VerticalAlignment="Top" Width="341"/>
        <DataGrid x:Name="datagrid" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="datagrid_SelectionChanged"/>

    </Grid>
</Window>
